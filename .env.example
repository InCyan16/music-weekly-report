# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Music Provider (spotify | mock)
MUSIC_PROVIDER=spotify
MUSIC_CLIENT_ID=
MUSIC_CLIENT_SECRET=
MUSIC_REDIRECT_URI=http://localhost:3000/api/music/callback
SPOTIFY_MARKET=TW

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_USE_MOCK_MUSIC_PROVIDER=false

# Demo 搜索：允许 /api/music/search/public（开发环境默认开启）
ALLOW_PUBLIC_SPOTIFY_SEARCH=true

# Playback
PLAYBACK_PROGRESS_UPDATE_INTERVAL_MS=10000
PLAYBACK_DEFAULT_VALID_THRESHOLD_MS=30000
